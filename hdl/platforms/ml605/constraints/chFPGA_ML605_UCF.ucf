# -- ADCDAQ

# The following confines the ADCDAQ logic to the clock regions where the ADC clock is entering and most or all of the data bytes are processed.
# This is not necessary to make the design compile, but makes the routing less messy
# Hopefully this will also help the P&R tool
# Note: some dedicated ressources (IBUFDS, ISERDES, BUFG) are necessarily outside the designated area due to pin and chip architectre constraints. In this case, the Area constraints below are ignored.   
# Force all logic to be in CLOCKREGION_X0Y1
# -----------------------
# |   CLOCKREGION_X0Y1  | 
# |  BANK 13 |  BANK 23 |
# | (ADC 6,7)| (ADC 2,3)|
# -----------------------
# |   CLOCKREGION_X0Y0  | 
# |  BANK 12 |  BANK 22 |
# | (ADC 4,5)| (ADC 0,1)|
# -----------------------


# Bank 12
# The final wildcard is important to ensure all components under ADCDAQ are selected. Otherwise the constraint is ignored and the component is placed in theprevious ANTGEN[] constraint. 
# 

INST "CHFPGA0/ANTGEN[4].ANTn/ADCDAQ0*" AREA_GROUP = "ADCDAQ_BANK12";
INST "CHFPGA0/ANTGEN[5].ANTn/ADCDAQ0*" AREA_GROUP = "ADCDAQ_BANK12";
AREA_GROUP "ADCDAQ_BANK12" RANGE=SLICE_X0Y0:SLICE_X11Y39;
AREA_GROUP "ADCDAQ_BANK12" RANGE=RAMB18_X0Y0:RAMB18_X0Y15;
AREA_GROUP "ADCDAQ_BANK12" RANGE=RAMB36_X0Y0:RAMB36_X0Y7;

# Bank 13
# To allow placement of other logic other than slices and RAMB
# 

INST "CHFPGA0/ANTGEN[6].ANTn/ADCDAQ0*" AREA_GROUP = "ADCDAQ_BANK13";
INST "CHFPGA0/ANTGEN[7].ANTn/ADCDAQ0*" AREA_GROUP = "ADCDAQ_BANK13";
AREA_GROUP "ADCDAQ_BANK13" RANGE=SLICE_X0Y40:SLICE_X11Y79; #was X7
AREA_GROUP "ADCDAQ_BANK13" RANGE=RAMB18_X0Y16:RAMB18_X0Y31;
AREA_GROUP "ADCDAQ_BANK13" RANGE=RAMB36_X0Y8:RAMB36_X0Y15;


# Bank 22

INST "CHFPGA0/ANTGEN[0].ANTn/ADCDAQ0*" AREA_GROUP = "ADCDAQ_BANK22";
INST "CHFPGA0/ANTGEN[1].ANTn/ADCDAQ0*" AREA_GROUP = "ADCDAQ_BANK22";
AREA_GROUP "ADCDAQ_BANK22" RANGE=SLICE_X56Y0:SLICE_X71Y39; #was X62

# Bank 23

INST "CHFPGA0/ANTGEN[2].ANTn/ADCDAQ0*" AREA_GROUP = "ADCDAQ_BANK23";
INST "CHFPGA0/ANTGEN[3].ANTn/ADCDAQ0*" AREA_GROUP = "ADCDAQ_BANK23";
AREA_GROUP "ADCDAQ_BANK23" RANGE=SLICE_X56Y40:SLICE_X71Y79;




#INST "CHFPGA0/ANTGEN[?].ANTn/CTRL_ROUTER0/*" AREA_GROUP = "TIMING_REG_AREA";
#AREA_GROUP "TIMING_REG_AREA" RANGE=SLICE_X84Y86:SLICE_X91Y239, SLICE_X84Y0:SLICE_X91Y59, SLICE_X72Y160:SLICE_X83Y239;

# Remove area constraints from the ones set above. **** This must come last. **** 
# Timing registers
#INST "*ROUTER?/FIFO0/*" AREA_GROUP = "NO_CONSTRAINT";
#INST "*SLAVE?/FIFO0/*" AREA_GROUP = "NO_CONSTRAINT";
#INST "*NO_AREA_CONSTR*" AREA_GROUP = "NO_CONSTRAINT";
#AREA_GROUP "NO_CONSTRAINT" RANGE=CLOCKREGION_X0Y0:CLOCKREGION_X1Y5;


# To override register ordering (which forces all register on the same vector to be packed in the same slices). The _? ending it to make sure we do not pick up other gates derived with the same name. The ? is the index number.
#INST "*_NOPACK*" BEL = AFF;


# LOC the BUFR so they don't end up in other clock regions, as the Mapper/Router does by default, which messes up timing
# These constraints must be commented out if a dummy ADCDAQ is implemented
# In CLOCKREGION_X0Y0 
INST "CHFPGA0/ANTGEN[0].ANTn/ADCDAQ0/impl_gen.bufr_gen[0].bufr0" LOC = BUFR_X1Y1;
# In CLOCKREGION_X0Y0
INST "CHFPGA0/ANTGEN[1].ANTn/ADCDAQ0/impl_gen.bufr_gen[0].bufr0" LOC = BUFR_X1Y0;
# In CLOCKREGION_X0Y0 
INST "CHFPGA0/ANTGEN[2].ANTn/ADCDAQ0/impl_gen.bufr_gen[0].bufr0" LOC = BUFR_X1Y2;
# In CLOCKREGION_X0Y0 
INST "CHFPGA0/ANTGEN[3].ANTn/ADCDAQ0/impl_gen.bufr_gen[0].bufr0" LOC = BUFR_X1Y3;
# In CLOCKREGION_X0Y0
INST "CHFPGA0/ANTGEN[4].ANTn/ADCDAQ0/impl_gen.bufr_gen[0].bufr0" LOC = BUFR_X0Y0;
# In CLOCKREGION_X0Y0
INST "CHFPGA0/ANTGEN[5].ANTn/ADCDAQ0/impl_gen.bufr_gen[0].bufr0" LOC = BUFR_X0Y1;
# In CLOCKREGION_X0Y1
INST "CHFPGA0/ANTGEN[6].ANTn/ADCDAQ0/impl_gen.bufr_gen[0].bufr0" LOC = BUFR_X0Y3;
# In CLOCKREGION_X0Y1
INST "CHFPGA0/ANTGEN[7].ANTn/ADCDAQ0/impl_gen.bufr_gen[0].bufr0" LOC = BUFR_X0Y2;

# LOC the ANT1 MMCM
# Make sure the ADC0 PLL is placed in an accessible clock region. That is not the case when using SmartGuide
INST "CHFPGA0/ANTGEN[1].ANTn/ADCDAQ0/impl_gen.pll_gen.pll0/mmcm_adv_inst" LOC = MMCM_ADV_X0Y0;


# -- REFCLK
# Force the location of the REFCLK BUFG in Bank 14 so it won't use the BUFG needed for the ADC clocks
INST "CHFPGA0/REFCLK0/FMCBUFR0" LOC = BUFR_X0Y4;
# Make sure that the ADC SYNC signal is registered in the IOB to ensure good timing
INST "CHFPGA0/REFCLK0/ADC_SYNC" IOB =FORCE;

# -- FREQCTR
#INST "CHFPGA0/FREQ_CTR0/SRCCLK0" LOC = BUFR_X1Y11;





# PlanAhead Generated physical constraints 


NET "ADC_SYNC_N" LOC = AJ22;
NET "ADC_SYNC_P" LOC = AK22;

