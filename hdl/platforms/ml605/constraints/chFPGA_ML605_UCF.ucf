# -------------------------------------------
# --------- TIMING CONSTRAINTS --------------
# -------------------------------------------



#   MGT Constraints
# -- Enable constraints below if MGT_DIST is implemented
# -- MGT Reference clock
#NET "MGT4_CLK_M2C_P" TNM_NET = "MGT4_CLK_M2C_P";
#TIMESPEC "TS_MGT4_CLK_M2C_P" = PERIOD "MGT4_CLK_M2C_P" 3.2; # 312.5 MHz Reference clock to MGTs
# -- MGT User Clock
#NET "MGTDIST*/TXUSRCLK" TNM_NET = "USRCLK"; # 
#TIMESPEC "TS_USRCLK" = PERIOD "USRCLK" 250 MHz; # 
#NET "MGTDIST*/TXUSRCLK2*" TNM_NET = "USRCLK2"; # 
#TIMESPEC "TS_USRCLK2" = PERIOD "USRCLK2" 125 MHz; # 

# -- PHY
NET "PHY_RXCLK" TNM_NET = "PHY_RXCLK";
TIMESPEC TS_PHY_RXCLK = PERIOD "PHY_RXCLK" 125 MHz;

# -- FMC Reference
NET "REFCLK_M2C_P" TNM_NET = "REFCLK_M2C";
TIMESPEC TS_REFCLK_M2C = PERIOD "REFCLK_M2C" 10 MHz HIGH 50 %;

# -- Frequency counter
# 120406 JFC: Added to see if this eliminates the problem where the frequency counter yields bad values for some implementations 
NET "CHFPGA0/FREQ_CTR0/SRC_CLK" TNM_NET = "SRC_CLK";
# This means that the input clock can be 400 MHz since we divide by two.
TIMESPEC TS_SRC_CLK = PERIOD "SRC_CLK" 200 MHz HIGH 50 %;


#-- ADC clock inputs

NET "ADC0_BDRP" TNM_NET = "ADC0_BDRP";
#TIMESPEC TS_ADC0_B_CLK = PERIOD "ADC0_BDRP" 425 MHz HIGH 50%;
#TIMEGRP ADC0B_CLK_GROUP = ADC0_BDRP;
# Use 3 decimal period to match the MMCM configuration
TIMESPEC TS_ADC0_B_CLK = PERIOD "ADC0_BDRP" 2.353 ns PRIORITY -10;

NET "ADC0_ADRP" TNM_NET = "ADC0_ADRP";
# There is a delay between the clocks that will need to be adjusted using the delay lines 
TIMESPEC TS_ADC0_A_CLK = PERIOD "ADC0_ADRP" TS_ADC0_B_CLK ;

NET "ADC0_CDRP" TNM_NET = "ADC0_CDRP";
TIMESPEC TS_ADC0_C_CLK = PERIOD "ADC0_CDRP" TS_ADC0_B_CLK ;

NET "ADC0_DDRP" TNM_NET = "ADC0_DDRP";
TIMESPEC TS_ADC0_D_CLK = PERIOD "ADC0_DDRP" TS_ADC0_B_CLK ;


NET "ADC1_ADRP" TNM_NET = "ADC1_ADRP";
TIMESPEC TS_ADC1_A_CLK = PERIOD "ADC1_ADRP" 425 MHz HIGH 50 %;

NET "ADC1_BDRP" TNM_NET = "ADC1_BDRP";
TIMESPEC TS_ADC1_B_CLK = PERIOD "ADC1_BDRP" 425 MHz HIGH 50 %;

NET "ADC1_CDRP" TNM_NET = "ADC1_CDRP";
TIMESPEC TS_ADC1_C_CLK = PERIOD "ADC1_CDRP" 425 MHz HIGH 50 %;

NET "ADC1_DDRP" TNM_NET = "ADC1_DDRP";
TIMESPEC TS_ADC1_D_CLK = PERIOD "ADC1_DDRP" 425 MHz HIGH 50 %;

#INST "ADC0_CH*" TNM = ADC0_C;
#TIMEGRP "ADC0_C" OFFSET = IN 0.625 ns VALID 1.25 ns BEFORE "ADC0_CDRP" RISING;
#TIMEGRP "ADC0_C" OFFSET = IN 0.625 ns VALID 1.25 ns BEFORE "ADC0_CDRP" FALLING;

############################
# Exclude cross-domain clock paths
############################
# Override the default derived MMCM output clocks with PERIOD constraints that are not related to each other so the tools will not analyze timing between these clocks
NET "CHFPGA0/CLK0/CLK125_NOBUF" TNM_NET = "CLK125";
NET "CHFPGA0/CLK0/CORR_CLK_NOBUF" TNM_NET = "CORR_CLK";
NET "CHFPGA0/CLK0/CLK200" TNM_NET = "CLK200";
NET "CHFPGA0/CLK0/SYSMON_CLK_NOBUF" TNM_NET = "SYSMON_CLK";
NET "CHFPGA0/REFCLK0/CLK10" TNM_NET = "CLK10";

# -- System clock
NET "SYSCLK_P" TNM_NET = "SYSCLK";


#TIMEGRP ANT_CLK_GROUP = CLK200 ADC0_ADRP ADC0_BDRP ADC0_CDRP ADC0_DDRP ADC1_ADRP ADC1_BDRP ADC1_CDRP ADC1_DDRP;
TIMEGRP SYSCLK_GROUP =  "SYSCLK";
TIMEGRP CLK200_GROUP =  "CLK200";
TIMEGRP CLK125_GROUP =  "CLK125";
TIMEGRP CORR_CLK_GROUP =  "CORR_CLK";
TIMEGRP SYSMON_CLK_GROUP =  "SYSMON_CLK";


TIMESPEC TS_SYSCLK_P = PERIOD "SYSCLK_GROUP" 200 MHz;
#TIMESPEC TS_CLK200 = PERIOD CLK200_GROUP 200 MHz;
TIMESPEC TS_CLK125 = PERIOD "CLK125_GROUP" 125 MHz;
TIMESPEC TS_CORR_CLK = PERIOD "CORR_CLK_GROUP" 225 MHz;
TIMESPEC TS_SYSMON_CLK = PERIOD "SYSMON_CLK_GROUP" 62.5 MHz;

# Redefine the clock timing constraints after the clock mux so the interactions with CLK200 are not considered
TIMESPEC TS_CLK10 = PERIOD "CLK10" 10 MHz;


# Exclude path between ANT and CTRL (in CTRL_SLAVE modules)
#TIMESPEC TS_ANT_TO_CTRL = FROM ANT_CLK_GROUP TO CTRL_CLK_GROUP TIG;
#TIMESPEC TS_CTRL_TO_ANT = FROM CTRL_CLK_GROUP TO ANT_CLK_GROUP TIG;
# Exclude path between CORR and CTRL (in CTRL_SLAVE modules)
#TIMESPEC TS_CORR_TO_CTRL = FROM CORR_CLK_GROUP TO CTRL_CLK_GROUP TIG;
#TIMESPEC TS_CTRL_TO_CORR = FROM CTRL_CLK_GROUP TO CORR_CLK_GROUP TIG;
# Exclude path between ANT and CORR (at the FIFO interface between the two))
#TIMESPEC TS_CORR_TO_ANT = FROM CORR_CLK_GROUP TO ANT_CLK_GROUP TIG;
#TIMESPEC TS_ANT_TO_CORR = FROM ANT_CLK_GROUP TO CORR_CLK_GROUP TIG;


# -------------------------------------------
# --------- TIMING IGNORE -------------------
# -------------------------------------------

# -- Global 
#INST "*_TIMING_IGNORE*" TIG;  
#NET "*_TIMING_IGNORE*" TIG;  

# FIFOs: Ignore timing on asynchronous FIFOs - They are designed to handle clock boundary crossing
#NET "*/grf.rf/*gcx.clkx/wr_pntr_gc*" TIG; 
#NET "*/grf.rf/*gcx.clkx/rd_pntr_gc*" TIG; 

# CTRL_SLAVE
#INST "*/CTRL_SLAVE0/CONTROL_BYTES_INT*" TIG; # the output of the CONTROL_WORD register goes to another clock domain. Ignore timing. #debug

#TIMESPEC TS_TIG_200_125 = FROM "ADC0_BDRP" TO "CLK125_BUF" TIG;

# SYSMON
#PIN "SYSTEM0/SYSMON0/SYSMON_TIMING_IGNORE.DCLK" TIG; # SYSMON was originally spec'd at 200 MHz, but was downgraded later to 80 MHz. We still use it at 125 MHz, so we TIG this to try to eliminate the corresponding timing error (bu tit does not work).



