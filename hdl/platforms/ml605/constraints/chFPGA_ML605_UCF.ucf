
# -- SYSTEM CLOCK

## 5   on U11, 5 on U89 (DNP)
NET "SYSCLK_N" LOC = H9;
## 4   on U11, 4 on U89 (DNP)
NET "SYSCLK_P" LOC = J9;

# -- SYSTEM RESET

## 2   on SW10 pushbutton (active-high)
NET "CPU_RESET" LOC = H10;

# -- Fan

## 1   on Q24
NET "FAN_PWM" LOC = L10;
## 2   on R368
NET "FAN_TACH" LOC = M10;

# -- GPIO

## GPIO_SW_C 2   on SW9 pushbutton (active-high) GPIO_BUTTON0
NET "GPIO_BUTTON0" LOC = G26;
## 2   on LED DS12, 1 on J62
NET "GPIO_LED[0]" LOC = AC22;
## 2   on LED DS11, 2 on J62
NET "GPIO_LED[1]" LOC = AC24;
## 2   on LED DS9,  3 on J62
NET "GPIO_LED[2]" LOC = AE22;
## 2   on LED DS10, 4 on J62
NET "GPIO_LED[3]" LOC = AE23;
## 2   on LED DS15, 5 on J62
NET "GPIO_LED[4]" LOC = AB23;
## 2   on LED DS14, 6 on J62
NET "GPIO_LED[5]" LOC = AG23;
## 2   on LED DS22, 7 on J62
NET "GPIO_LED[6]" LOC = AE24;
## 2   on LED DS21, 8 on J62
NET "GPIO_LED[7]" LOC = AD24;

## 1   on SW1 DIP switch (active-high)
NET "GPIO_DIP_SW[0]" LOC = D22;
## 2   on SW1 DIP switch (active-high)
NET "GPIO_DIP_SW[1]" LOC = C22;
## 3   on SW1 DIP switch (active-high)
NET "GPIO_DIP_SW[2]" LOC = L21;
## 4   on SW1 DIP switch (active-high)
NET "GPIO_DIP_SW[3]" LOC = L20;

# -- LCD
## 4   on J41
NET "LCD_DB[4]" LOC = AD14;
## 3   on J41
NET "LCD_DB[5]" LOC = AK11;
## 2   on J41
NET "LCD_DB[6]" LOC = AJ11;
## 1   on J41
NET "LCD_DB[7]" LOC = AE12;
## 9   on J41
NET "LCD_E" LOC = AK12;
## 11  on J41
NET "LCD_RS" LOC = T28;
## 10  on J41
NET "LCD_RW" LOC = AC14;

# -- SMA Connectors
## 1   on J55 SMA, Bank 24
NET "USER_SMA_CLOCK_N" LOC = M22;
NET "USER_SMA_CLOCK_N" IOSTANDARD = LVDCI_25;
NET "USER_SMA_CLOCK_N" DRIVE = 24;
NET "USER_SMA_CLOCK_N" SLEW = FAST;
## 1   on J58 SMA, Bank 24
NET "USER_SMA_CLOCK_P" LOC = L23;
NET "USER_SMA_CLOCK_P" IOSTANDARD = LVDCI_25;
NET "USER_SMA_CLOCK_P" DRIVE = 24;
NET "USER_SMA_CLOCK_P" SLEW = FAST;
# Use the reference resistorss of bank 23 as master for setting the impedance on Bank 24
CONFIG DCI_CASCADE = "23 24";

## 1   on J56 SMA, Bank 14
NET "USER_SMA_GPIO_N" LOC = W34;
NET "USER_SMA_GPIO_N" IOSTANDARD = LVCMOS25;
NET "USER_SMA_GPIO_N" DRIVE = 24;
NET "USER_SMA_GPIO_N" SLEW = FAST;
## 1   on J57 SMA, Bank 14
NET "USER_SMA_GPIO_P" LOC = V34;
NET "USER_SMA_GPIO_P" IOSTANDARD = LVCMOS25;
NET "USER_SMA_GPIO_P" DRIVE = 4;
NET "USER_SMA_GPIO_P" SLEW = SLOW;
#NET "USER_SMA_GPIO_P"		LOC = "V34" | IOSTANDARD="LVCMOS25" | DRIVE=24 | SLEW="FAST";    ## 1   on J57 SMA, Bank 14
#CONFIG DCI_CASCADE = "15 14"; # Use the reference resistor of bank 15 as master for setting the impecance on Bank 14 


