# Exclude everything by default
**
# Allow subfolders, but not files in them yet
!/chfpga_*/


# !*.srcs/**/*.rqs
# !*.srcs/**/*
# !*/
# Add files we want in this directory
!/.gitignore

# The following makes the desirable project directories and their contents visible
!testbenches/
!testbenches/*/
# !test_projects/*/


# Include all files in project directories with specific extensions
# We prefer to whitelist here, because Vivado has a knack for adding generated contents we did not expect.
!*.bit
!*.tcl
!*.xpr
!.gitignore
!*.rqs
!*.wcfg
!*.txt

# Some harmless exceptions, used in some folders
!*.xdc
!*.xise
