# BUILDS

# ---------------------
# IceBoard-based builds (Kintex 7 FPGA)
# ---------------------

# 400 MHz-bandwidth Corner-turn configuration
# (CHIME/HIRAX/FRB Outriggers)
!/chfpga_ice_ct/

# 400 MHz bandwidth Single-board correlator configuration
# (For development and small interferometers)
!/chfpga_ice_corr16/

# 1200 MHz bandwidth corner-turn configuration
# (old CHORD candidate, not maintained)
!/chordFPGA_MGK7MB/


# ---------------------
# CRS-based builds (Ultrascale+ RfSoC FPGA)
# ---------------------

# 1600 MHz bandwidth single-board correlator configuration
# (D3A, development, small interferometers)
!/chfpga_crs_corr8/


# 1600 MHz bandwidth 8-board correlator configuration
# (t0 demonstrator)
!/chfpga_crs_corr64/


# 1600 MHz bandwidth corner-turn configuration
# (CHORD and its future outriggers)
!/chfpga_crs_ct/




# ---------------------
# ML605-based builds (Virtex 6 FPGA)
# ---------------------

# 800 MHz bandwidth configuration
# (CHIME proof of concept, not maintained)
!/chFPGA_ML605/



