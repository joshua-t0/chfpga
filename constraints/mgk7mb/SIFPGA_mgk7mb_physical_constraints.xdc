#################################
# BP IO PINS
#################################

# BP0 on BP_IO5 (AG27, SMA A): Sync out
# BP1 on BP_IO4 (W26, SMA B)
# BP2 on BP_IO0_P (AG30)
# BP3 on BP_IO0_N (AH30)
# BP4 on BP_IO1_P (AJ29)
# BP5 on BP_IO1_N (AK30)
# BP6 on BP_IO2_P (AK28)
# BP7 on BP_IO2_N (AK29)
# BP8 on BP_IO3   (W24)

# | port name        | FPGA pin | Schematic net name | Motherboard Connectivity | Backplane connectivity (MRK7BP16 Rev2)
# |----------------  |----------|--------------------|--------------------------|------------------------
# | sma_a            | AG27     | BP_IO5             | SMA_A                    | NC (Rev0: ref_cap)
# | sma_b_fpga_led2  | W26      | BP_IO4             | SMA-B  SW8  FPGA_LED2    | BP_LED (Rev0: slotid_cap1)
# | bp_time_p        | AG30     | BP_IO0_P           |        SW1               | time_p
# | bp_time_n        | AH30     | BP_IO0_N           |        SW2               | time_n
# | bp_trig_p        | AJ29     | BP_IO1_P           |        SW3               | trig_p
# | bp_trig_n        | AK30     | BP_IO1_N           |        SW4               | trig_n
# | bp_gpio_int      | AK28     | BP_IO2_P           |        SW5               | gpio_int
# | bp_buck_sync     | AK29     | BP_IO2_N           |        SW6               | buck_sync
# | fpga_led1_bp_sma | W24      | BP_IO3             |        SW7  FPGA_LED1    | BP_SMA (Rev0: slotid_cap0)
#
# All single-ended signals are LVCMOS25
# All Differentials are LVDS_25
# Differential signals can be used as two independend single-ended lines

# SMA A
set_property PACKAGE_PIN AG27 [get_ports sma_a]
set_property IOSTANDARD LVCMOS25 [get_ports sma_a]
set_property SLEW FAST [get_ports sma_a]
set_property DRIVE 16 [get_ports sma_a]

# SMA B - FPGA LED2
set_property PACKAGE_PIN W26 [get_ports sma_b_fpga_led2]
set_property IOSTANDARD LVCMOS25 [get_ports sma_b_fpga_led2]
set_property SLEW FAST [get_ports sma_b_fpga_led2]
set_property DRIVE 16 [get_ports sma_b_fpga_led2]

# FPGA LED1 / Backplane SMA
set_property PACKAGE_PIN W24 [get_ports fpga_led1_bp_sma]
set_property IOSTANDARD LVCMOS25 [get_ports fpga_led1_bp_sma]
set_property SLEW FAST [get_ports fpga_led1_bp_sma]
set_property DRIVE 16 [get_ports fpga_led1_bp_sma]

# Backplane TIME
set_property PACKAGE_PIN AH30 [get_ports bp_time_n]
set_property IOSTANDARD LVDS_25 [get_ports bp_time_p]
# set_property IOSTANDARD LVCMOS25 [get_ports bp_time_p]
# set_property IOSTANDARD LVCMOS25 [get_ports bp_time_n]

# Backplane TRIG
set_property PACKAGE_PIN AJ29 [get_ports bp_trig_p]
set_property IOSTANDARD LVDS_25 [get_ports bp_trig_p]

# Backplane GPIO_INT
set_property PACKAGE_PIN AK28 [get_ports bp_gpio_int]
set_property IOSTANDARD LVCMOS25 [get_ports bp_gpio_int]
